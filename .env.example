# PostgreSQL 연결 문자열 (로컬 개발 예시)
DATABASE_URL=postgresql://sobicut:sobicut@localhost:5432/sobicut

# JWT 서명 키 — 배포 시 반드시 변경 (openssl rand -hex 32)
SECRET_KEY=change-me-to-a-random-64-char-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS 허용 origin (콤마로 구분, 프론트 개발 서버 기본값)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 웹 푸시 VAPID 키 — python scripts/generate_vapid_keys.py로 생성
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=admin@sobicut.app

# Claude API (주간 소비 처방 생성) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
# 미분류 거래 카테고리 LLM fallback 전용 모델.
# POST /transactions/parse 의 사용자 대기 중 동기 응답 경로에서 쓰이므로
# 처방용(CLAUDE_MODEL)과 분리해 가볍게/빠르게 교체할 수 있게 둔다.
CLAUDE_MODEL_CATEGORY=claude-haiku-4-5-20251001
# 카테고리 LLM fallback 의 HTTP 요청 timeout(초).
# 실측상 정상 응답이 3.0~4.5초 걸려 기존 하드코딩 5.0초는 여유가 부족했다
# (지연이 조금만 겹쳐도 실패 → 룰 미매칭 건이 미분류로 떨어짐).
# Claude 전환 후 10.0 → 15.0: structured outputs 는 스키마를 grammar 로 컴파일하며
# 동일 스키마의 첫 요청에 컴파일 지연이 붙는다(결과는 24시간 캐싱).
CLAUDE_CATEGORY_TIMEOUT=15.0