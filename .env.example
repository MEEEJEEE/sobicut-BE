# PostgreSQL 연결 문자열 (로컬 개발 예시)
DATABASE_URL=postgresql://sobicut:sobicut@localhost:5432/sobicut

# JWT 서명 키 — 배포 시 반드시 변경 (openssl rand -hex 32)
SECRET_KEY=change-me-to-a-random-64-char-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS 허용 origin (콤마로 구분, 프론트 개발 서버 기본값)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 웹 푸시 VAPID 키 — python scripts/generate_vapid_keys.py로 생성
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=admin@sobicut.app
